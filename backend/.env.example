DATABASE_URL=postgresql+psycopg://caetus:caetus@localhost:5432/caetus
JWT_SECRET=troque-este-valor
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./storage_local
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ───────── BYOK (chaves de IA por empresa) ─────────
# Chave que cifra as credenciais dos clientes no banco (Fernet). Gere com:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Guarde-a como segredo do ambiente; NÃO a troque sem migrar as credenciais.
CREDENCIAIS_MASTER_KEY=
# false = empresas sem chave própria NÃO usam as chaves abaixo (recomendado em produção BYOK)
IA_USAR_CHAVES_DA_PLATAFORMA=true
# e-mails (csv) que operam a plataforma: veem saúde dos provedores, benchmark etc.
PLATFORM_ADMIN_EMAILS=
# só dev: provedor sem chave devolve "[stub ...]" em vez de erro
IA_PERMITIR_STUB=false

# ───────── Provedores de IA (chaves da PLATAFORMA — opcionais com BYOK) ─────────
# Modelos NUNCA ficam fixos no código — alteráveis aqui.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Cloudflare Workers AI (texto) — exige token + account id
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Hugging Face
HUGGINGFACE_API_KEY=
HF_MODEL=black-forest-labs/FLUX.1-schnell

# Fal.ai
FAL_KEY=
FAL_MODEL=flux/schnell
FAL_VIDEO_MODEL=fal-ai/minimax-video

# ───────── Modelos especializados (Fase 5.1) — opcionais ─────────
GEMINI_VISION_MODEL=
OPENROUTER_VISION_MODEL=
HF_OCR_MODEL=microsoft/trocr-large-printed
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_BACKGROUND_MODEL=briaai/RMBG-1.4
HF_VISION_MODEL=Salesforce/blip-image-captioning-large

# Replicate (reservado — Fase 6)
REPLICATE_API_KEY=
REPLICATE_IMAGE_MODEL=
REPLICATE_UPSCALE_MODEL=
REPLICATE_INPAINT_MODEL=

# Cloudflare Workers AI (capability image-generator)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ───────── Prioridade de provedores de imagem (capability image-generator) ─────────
# Lista separada por vírgula, ex.: cloudflare,gemini. Por enquanto só cloudflare.
IMAGE_PROVIDER_PRIORITY=cloudflare

# ───────── Perfis e Modo de Roteamento ─────────
IA_PROFILE=production
IA_MODO=automatico

# ───────── Observabilidade (Fase 6) ─────────
# DEBUG=true habilita stacktrace nas respostas e modo dev permissivo.
DEBUG=false
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false        # true em produção (Loki/ELK/Grafana)
LOG_COLOR=true        # cores ANSI em DEV (auto-desabilitadas se não-TTY)
